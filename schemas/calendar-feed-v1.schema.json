{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GaryLiuGTA/omarchy_chinese_lunar_calendar/schemas/calendar-feed-v1.schema.json",
  "title": "Omarchy typed calendar feed",
  "type": "object",
  "required": [
    "schemaVersion",
    "records"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "generatedAt": {
      "type": "string"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "span",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sourceId": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "schedule",
              "festival",
              "event"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "number"
          },
          "span": {
            "type": "object",
            "required": [
              "mode",
              "start"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "date",
                  "datetime"
                ]
              },
              "start": {
                "type": "string"
              },
              "end": {
                "type": "string"
              },
              "endExclusive": {
                "type": "string"
              },
              "timeZone": {
                "type": "string"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "mode": {
                      "const": "date"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "start": {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    },
                    "end": {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    },
                    "endExclusive": {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "mode": {
                      "const": "datetime"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "start": {
                      "type": "string",
                      "pattern": "(Z|[+-]\\d{2}:\\d{2})$"
                    },
                    "end": {
                      "type": "string",
                      "pattern": "(Z|[+-]\\d{2}:\\d{2})$"
                    }
                  }
                }
              }
            ]
          },
          "payload": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "off",
                  "work"
                ]
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "schedule"
                }
              }
            },
            "then": {
              "required": [
                "payload"
              ],
              "properties": {
                "payload": {
                  "required": [
                    "status"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "schedule",
                    "festival"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "span": {
                  "properties": {
                    "mode": {
                      "const": "date"
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
